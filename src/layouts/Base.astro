---
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import Rum from '../components/Rum.astro';
import { href } from '../lib/format';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Software, data, and models from the Institute of Environmental Sciences (CML), Leiden University.' } =
  Astro.props;

// Cache-bust the card by content: link previews cache og.png hard.
const ogHash = createHash('sha256').update(readFileSync('public/og.png')).digest('hex').slice(0, 8);
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png?v=${ogHash}`, Astro.site).href;
const ogAlt =
  'CML Project Gallery: software, data and models built at CML, in one place. A ledger lists the first five entries: R9lab, r9cam, monitoring, RaMa-Scene and CML Project Gallery, each tagged software. Marked as a prototype, not an official CML site.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CML Project Gallery" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    <Rum />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href('/')} aria-label="CML Project Gallery, home">
          <svg class="brand-mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="#2f6b4f"></rect>
            <path d="M16 6C10 10 8 14 8 19a8 8 0 0 0 16 0c0-5-2-9-8-13z" fill="#f2f4f1"></path>
            <path d="M16 9v14" stroke="#2f6b4f" stroke-width="1.4" fill="none"></path>
          </svg>
          <span class="brand-word">CML</span>
        </a>
        <span class="eyebrow">Project Gallery</span>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>Prototype for discussion: not an official CML site.</span>
        <span>
          Data: <a href={href('projects.json')}>projects.json</a>{' · '}<a href={href('schema.json')}>schema.json</a>
        </span>
        <a href="https://github.com/CMLPlatform">CMLPlatform on GitHub</a>
      </div>
    </footer>
  </body>
</html>
